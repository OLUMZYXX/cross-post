{
  "expo": {
    "name": "cross-post",
    "slug": "cross-post",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "crosspost",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#022C22"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.crosspostapp.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserNotificationsUsageDescription": "CrossPost needs notifications to alert you when posts are published, fail, or are about to go live.",
        "NSPhotoLibraryUsageDescription": "CrossPost needs access to your photo library so you can choose photos and videos to attach to your posts. For example, you can pick an image from your library to publish to your connected social media accounts.",
        "NSCameraUsageDescription": "CrossPost needs access to your camera so you can capture a photo or video to attach to your posts. For example, you can take a picture and publish it to your connected social media accounts.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.1060869198401-ft8s5gbsfd1m8s8ml0f9565pt5thfirt",
              "crosspost"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.crosspost.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B141A"
      },
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#4ade80"
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "e6e6d941-ff9c-474f-bdb1-5ce54de12693"
      }
    },
    "owner": "mide_1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e6e6d941-ff9c-474f-bdb1-5ce54de12693"
    }
  }
}
