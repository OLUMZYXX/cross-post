# Server
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/crosspost
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# Client URL (used for OAuth redirect URIs)
CLIENT_URL=http://localhost:4000

# Public URL of this server. Must be the domain verified with TikTok,
# since TikTok pulls photo posts from ${SERVER_URL}/media/tiktok-image
SERVER_URL=http://localhost:4000

# Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Instagram (uses Facebook Graph API)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Comma-separated site-verification codes (production and sandbox).
# Each is served at /tiktok<code>.txt for domain verification.
TIKTOK_VERIFICATION_CODES=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# YouTube / Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
